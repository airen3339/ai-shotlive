    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "ai": "^6.0.191",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.22.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
