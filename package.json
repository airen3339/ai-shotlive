{
  "name": "cinegen-director",
  "version": "1.0.0",
  "description": "AI漫剧导演工具 - 基于控制论思想的4阶段创作工作流",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "DB_TYPE=sqlite tsx watch server/src/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
